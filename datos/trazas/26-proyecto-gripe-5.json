{"codigo":"using Test\nN = 763\nfunction sir(u, β, γ)\n    contagios = β * u[1] * u[2] / N\n    curas = γ * u[2]\n    return [-contagios, contagios - curas, curas]\nend\nfunction paso(u, h, β, γ)\n    k1 = sir(u, β, γ)\n    k2 = sir(u + h / 2 * k1, β, γ)\n    k3 = sir(u + h / 2 * k2, β, γ)\n    k4 = sir(u + h * k3, β, γ)\n    return u + h / 6 * (k1 + 2 * k2 + 2 * k3 + k4)\nend\nu = paso([762.0, 1.0, 0.0], 1.0, 1.67, 0.44)\n@test sum(u) ≈ 763\n@test sir([762.0, 1.0, 0.0], 0.0, 0.44)[2] < 0\nR0 = 1.67 / 0.44","filas":[],"pasos":[{"estado":{},"linea":null,"nfilas":0,"orden":[],"salida":"","tipo":"inicio"},{"estado":{},"linea":1,"nfilas":0,"orden":[],"salida":"","tipo":"linea"},{"estado":{"N":{"e":true,"t":"Int64","v":["763"]}},"linea":2,"nfilas":0,"orden":["N"],"salida":"","tipo":"linea"},{"estado":{"N":{"e":true,"t":"Int64","v":["763"]},"sir":{"m":1,"r":"sir(u, β, γ)","t":"function"}},"linea":3,"nfilas":0,"orden":["N","sir"],"salida":"","tipo":"linea"},{"estado":{"N":{"e":true,"t":"Int64","v":["763"]},"paso":{"m":1,"r":"paso(u, h, β, γ)","t":"function"},"sir":{"m":1,"r":"sir(u, β, γ)","t":"function"}},"linea":8,"nfilas":0,"orden":["N","sir","paso"],"salida":"","tipo":"linea"},{"estado":{"N":{"e":true,"t":"Int64","v":["763"]},"paso":{"m":1,"r":"paso(u, h, β, γ)","t":"function"},"sir":{"m":1,"r":"sir(u, β, γ)","t":"function"}},"funcion":"paso","linea":8,"marcos":[{"desde":15,"id":1,"llamada":"paso(u = [762.0, 1.0, 0.0], h = 1.0, β = 1.67, γ = 0.44)","nombre":"paso","orden":["u","h","β","γ"],"vars":{"h":{"e":true,"t":"Float64","v":["1.0"]},"u":{"el":"Float64","id":1,"t":"Vector{Float64}","v":["762.0","1.0","0.0"]},"β":{"e":true,"t":"Float64","v":["1.67"]},"γ":{"e":true,"t":"Float64","v":["0.44"]}}}],"nfilas":0,"orden":["N","sir","paso"],"salida":"","tipo":"llamada"},{"estado":{"N":{"e":true,"t":"Int64","v":["763"]},"paso":{"m":1,"r":"paso(u, h, β, γ)","t":"function"},"sir":{"m":1,"r":"sir(u, β, γ)","t":"function"}},"funcion":"sir","linea":3,"marcos":[{"desde":15,"id":1,"