{"codigo":"using Plots\nfunction euler(f, y0, t0, tf, n)\n    h = (tf - t0) / n\n    ts = [t0]\n    ys = [y0]\n    for i in 1:n\n        push!(ys, ys[end] + h * f(ts[end], ys[end]))\n        push!(ts, ts[end] + h)\n    end\n    return ts, ys\nend\ncafe(t, T) = -0.1 * (T - 20)\nts, Ts = euler(cafe, 90.0, 0.0, 30.0, 6)\nexacta = [20 + 70 * exp(-0.1 * t) for t in 0:30]\nplot(0:30, exacta, label = \"exacta\", xlabel = \"minutos\", ylabel = \"°C\")\nplot!(ts, Ts, label = \"Euler, 6 pasos\", marker = :o)","filas":[],"pasos":[{"estado":{},"linea":null,"nfilas":0,"orden":[],"salida":"","tipo":"inicio"},{"estado":{},"linea":1,"nfilas":0,"orden":[],"salida":"","tipo":"linea"},{"estado":{"euler":{"m":1,"r":"euler(f, y0, t0, tf, n)","t":"function"}},"linea":2,"nfilas":0,"orden":["euler"],"salida":"","tipo":"linea"},{"estado":{"cafe":{"m":1,"r":"cafe(t, T)","t":"function"},"euler":{"m":1,"r":"euler(f, y0, t0, tf, n)","t":"function"}},"linea":12,"nfilas":0,"orden":["euler","cafe"],"salida":"","tipo":"linea"},{"estado":{"cafe":{"m":1,"r":"cafe(t, T)","t":"function"},"euler":{"m":1,"r":"euler(f, y0, t0, tf, n)","t":"function"}},"funcion":"euler","linea":2,"marcos":[{"desde":13,"id":1,"llamada":"euler(f = cafe(t, T), y0 = 90.0, t0 = 0.0, tf = 30.0, n = 6)","nombre":"euler","orden":["f","y0","t0","tf","n"],"vars":{"f":{"m":1,"r":"cafe(t, T)","t":"function"},"n":{"e":true,"t":"Int64","v":["6"]},"t0":{"e":true,"t":"Float64","v":["0.0"]},"tf":{"e":true,"t":"Float64","v":["30.0"]},"y0":{"e":true,"t":"Float64","v":["90.0"]}}}],"nfilas":0,"orden":["euler","cafe"],"salida":"","tipo":"llamada"},{"estado":{"cafe":{"m":1,"r":"cafe(t, T)","t":"function"},"euler":{"m":1,"r":"euler(f, y0, t0, tf, n)","t":"function"}},"linea":3,"marcos":[{"desde":13,"id":1,"llamada":"euler(f = cafe(t, T), y0 = 90.0, t0 = 0.0, tf = 30.0, n = 6)","nombre":"euler","orden":["f","y0","t0","tf","n","h"],"vars":{"f":{"m":1,"r":"cafe(t, T)","t":"function"},"h":{"e":true,"t":"Float64","v":["5.0"]},"n":{"e":true,"t":"Int64"