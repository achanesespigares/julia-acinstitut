{"codigo":"function llega(i, meta, despues, vistas = Int[])\n    for j in despues[i]\n        j == meta && return true\n        if !(j in vistas)\n            push!(vistas, j)\n            llega(j, meta, despues, vistas) && return true\n        end\n    end\n    return false\nend\nceldas = [\"x = y + 1\", \"y = 2x\", \"z = 3\", \"z = 4\"]\ndefine = [:x, :y, :z, :z]\nusa = [[:y], [:x], Symbol[], Symbol[]]\nfor d in unique(define)\n    count(==(d), define) > 1 && println(\"Multiple definitions for \", d)\nend\ndespues = [findall(u -> d in u, usa) for d in define]\nciclo = [i for i in eachindex(celdas) if llega(i, i, despues)]\nprintln(\"Cyclic references among \", join(define[ciclo], \" and \"))","filas":[],"pasos":[{"estado":{},"linea":null,"nfilas":0,"orden":[],"salida":"","tipo":"inicio"},{"estado":{"llega":{"m":2,"r":"llega(i, meta, despues, vistas = Int[])","t":"function"}},"linea":1,"nfilas":0,"orden":["llega"],"salida":"","tipo":"linea"},{"estado":{"celdas":{"el":"String","id":1,"t":"Vector{String}","v":["\"x = y + 1\"","\"y = 2x\"","\"z = 3\"","\"z = 4\""]},"llega":{"m":2,"r":"llega(i, meta, despues, vistas = Int[])","t":"function"}},"linea":11,"nfilas":0,"orden":["llega","celdas"],"salida":"","tipo":"linea"},{"estado":{"celdas":{"el":"String","id":1,"t":"Vector{String}","v":["\"x = y + 1\"","\"y = 2x\"","\"z = 3\"","\"z = 4\""]},"define":{"el":"Symbol","id":2,"t":"Vector{Symbol}","v":[":x",":y",":z",":z"]},"llega":{"m":2,"r":"llega(i, meta, despues, vistas = Int[])","t":"function"}},"linea":12,"nfilas":0,"orden":["llega","celdas","define"],"salida":"","tipo":"linea"},{"estado":{"celdas":{"el":"String","id":1,"t":"Vector{String}","v":["\"x = y + 1\"","\"y = 2x\"","\"z = 3\"","\"z = 4\""]},"define":{"el":"Symbol","id":2,"t":"Vector{Symbol}","v":[":x",":y",":z",":z"]},"llega":{"m":2,"r":"llega(i, meta, despues, vistas = Int[])","t":"function"},"usa":{"el":"Vector{Symbol}","id":3,"t":"Vector{Vector{Symbol}}","v":["[:y]","[:x]","Symbol[]","Symbol[]"]}},"linea":13,